# Copy to .env.local and fill in. Only PUBLIC values belong here (they ship to the browser).
# Local: run `npx supabase status` after `npx supabase start`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=     

# "test" enables the sandbox payment Edge Function (server also needs TEST_PAYMENTS_ENABLED=true). Leave empty in production until the real gateway is live.
VITE_PAYMENT_PROVIDER=

# Public site URL used for canonical links, sitemap and structured data
VITE_SITE_URL=https://www.ozonescents.com
